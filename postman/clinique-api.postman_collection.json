            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"jourSemaine\": \"TUESDAY\", \"heureDebut\": \"08:00:00\", \"heureFin\": \"12:00:00\" },\n  { \"jourSemaine\": \"THURSDAY\", \"heureDebut\": \"13:00:00\", \"heureFin\": \"18:00:00\" }\n]"
            },
