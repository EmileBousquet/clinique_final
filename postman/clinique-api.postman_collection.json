          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"House\",\n  \"prenom\": \"Gregory\",\n  \"email\": \"house@clinique.com\",\n  \"motDePasse\": \"Medecin@123\",\n  \"specialiteId\": {{specialiteId}},\n  \"dureeConsultationMinutes\": 30,\n  \"horaires\": [\n    { \"jourSemaine\": \"MONDAY\", \"heureDebut\": \"09:00:00\", \"heureFin\": \"12:00:00\" },\n    { \"jourSemaine\": \"MONDAY\", \"heureDebut\": \"13:00:00\", \"heureFin\": \"17:00:00\" },\n    { \"jourSemaine\": \"WEDNESDAY\", \"heureDebut\": \"09:00:00\", \"heureFin\": \"15:00:00\" }\n  ]\n}"
            },
